# .htaccess alternativo (más compatible)
# Si el principal no funciona, renombrar este a .htaccess

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /reporteria/api/v1/
    
    # Permitir acceso directo a archivos existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirigir todo al index.php
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# CORS Headers (solo si mod_headers está disponible)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "3600"
</IfModule>

# Forzar tipo de contenido JSON para respuestas de la API
<FilesMatch "\.php$">
    <IfModule mod_headers.c>
        Header set Content-Type "application/json; charset=UTF-8"
    </IfModule>
</FilesMatch>
