Options ALL -Indexes

RewriteEngine On
RewriteRule ^([-a-zA-Z0-9]+)$ index.php?ruta=$1

# ===== CONFIGURACIÓN DE ENTORNO =====
SetEnv APP_ENV "Development"

# ===== CREDENCIALES DE BASE DE DATOS =====
SetEnv DB_HOST "127.0.0.1"
SetEnv DB_NAME "vos3000"
SetEnv DB_USER "root"
SetEnv DB_PASS "d57hgtfresh3rdxy78D"

# ===== CREDENCIALES DE BASE DE DATOS DEV =====
SetEnv DB_HOST_DEV "sw3.bestvoiper.com"
SetEnv DB_NAME_DEV "vos3000"
SetEnv DB_USER_DEV "developers"
SetEnv DB_PASS_DEV "Luisda0806*++"

# ===== OCULTAR ERRORES DE PHP EN PRODUCCIÓN =====
php_flag display_errors Off
php_flag display_startup_errors Off
php_value error_reporting 0

# Registrar errores en log (no mostrar al usuario)
php_flag log_errors On

# ===== PROTEGER ARCHIVOS SENSIBLES =====
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|ini|log|sql|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|\.gitignore|Dockerfile|docker-compose\.yml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept"
</IfModule>